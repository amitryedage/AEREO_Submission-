# Database connection string (SQLite by default, swap with PostgreSQL URL for production)
CERTGEN_DATABASE_URL=sqlite:///./data/certgen.db

# Storage root for generated PDF certificates
CERTGEN_STORAGE_DIR=./storage/certificates

# Maximum recipient count accepted per single job request
CERTGEN_MAX_RECIPIENTS_PER_JOB=1000

# Set to true to disable automatic recovery of queued/processing jobs on startup (useful in tests)
CERTGEN_DISABLE_RECOVERY=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
CERTGEN_LOG_LEVEL=INFO
